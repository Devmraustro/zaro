# =============================================================================
# ZARO API - Environment Template
# Copy to .env for local development. Never commit .env files.
# =============================================================================

# --- Application -----------------------------------------------------------
ZARO_ENVIRONMENT=development
ZARO_DEBUG=true
ZARO_APP_NAME=ZARO API
ZARO_VERSION=0.1.0

# --- Database --------------------------------------------------------------
ZARO_DATABASE_URL=postgresql+asyncpg://zaro:zaro_dev_password@postgres:5432/zaro

# --- Redis -----------------------------------------------------------------
ZARO_REDIS_URL=redis://redis:6379/1

# --- Security --------------------------------------------------------------
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(64))"
ZARO_SECRET_KEY=change-me-in-production
ZARO_JWT_ALGORITHM=HS256
ZARO_ACCESS_TOKEN_EXPIRE_MINUTES=30
ZARO_REFRESH_TOKEN_EXPIRE_DAYS=30
# Required in production (generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())")
ZARO_ENCRYPTION_KEY=
# Reject request bodies larger than this (bytes)
ZARO_MAX_REQUEST_BYTES=1048576
# When non-empty, requests with other Host headers are rejected (421).
# Set explicitly in production, e.g. ["api.example.com"]
ZARO_ALLOWED_HOSTS=[]

# --- CORS ------------------------------------------------------------------
# JSON array of allowed origins. Wildcards are rejected in production.
ZARO_CORS_ORIGINS=["http://localhost:3001"]

# --- File Storage ----------------------------------------------------------
ZARO_STORAGE_BACKEND=local
ZARO_STORAGE_LOCAL_DIR=./storage
ZARO_S3_ENDPOINT_URL=http://minio:9000
ZARO_S3_BUCKET=zaro-assets
ZARO_S3_ACCESS_KEY=zaro_minio
ZARO_S3_SECRET_KEY=zaro_dev_minio
ZARO_S3_REGION=us-east-1

# --- Rate Limiting ---------------------------------------------------------
# Global per-IP limit across all API routes (health probes exempt)
ZARO_RATE_LIMIT_ENABLED=true
ZARO_RATE_LIMIT_REQUESTS=120
ZARO_RATE_LIMIT_WINDOW_SECONDS=60
